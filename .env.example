# Optional. OpenAlex asks API clients to identify themselves with an email
# address and routes those requests through a faster, more reliable pool
# ("polite pool"). Without this the app still works, on the common pool.
#
# Copy this file to .env and fill in your own address. .env is gitignored, so no
# email address is ever committed to this public repository.
VITE_OPENALEX_MAILTO=
